FLEETFUEL_APP_NAME=FleetFuel API
FLEETFUEL_ENVIRONMENT=development
FLEETFUEL_API_V1_PREFIX=/api/v1
FLEETFUEL_CORS_ORIGINS=[]
FLEETFUEL_DATABASE_URL=postgresql+psycopg://fleetfuel:change-me@localhost:5432/fleetfuel
FLEETFUEL_JWT_SECRET=generate-a-random-value-for-local-development
FLEETFUEL_ATTACHMENT_DIRECTORY=private_uploads
FLEETFUEL_MAX_ATTACHMENT_BYTES=5000000
# Set production secrets and database credentials through the deployment environment.